{
  "description": "Fireplay production delivery check before ending a turn",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/bin/fireplay_stop_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
